# Binance Sentinel AI - environment configuration
# Copy this file to `.env.local` and fill in values as needed.
#
# All variables are OPTIONAL. The app works out of the box with the public
# Binance REST API fallback using no keys at all.
# ---------------------------------------------------------------------------

# --- Market data provider -------------------------------------------------
# Which market-data backend the agent pipeline should use.
# Built-in fallback (default) is a chained provider: Binance Public REST API
# primary, CoinGecko Public API secondary.
#   binance-public-api     (default)
#   coingecko-public-api   (force CoinGecko)
#   binance-mcp            (requires MCP env vars below + a real access token)
#   binance-cli-public-api (requires the official binance-cli binary + flag below)
# BINANCE_MARKET_DATA_PROVIDER=binance-public-api

# --- Binance CLI (official skill tooling, INACTIVE by default) ----------
# Integrates the read-only, PUBLIC market-data commands from the official
# Binance skill (.agents/skills/binance): spot klines / ticker24hr /
# exchange-info. Uses the `binance-cli` binary (see the skill's SKILL.md for
# installation). NO API credentials are required - these are public endpoints.
# The provider is NOT in the default chain; it activates only when enabled here
# AND selected above. Local/self-hosted only (shells out to a local binary).
# BINANCE_ENABLE_CLI_PROVIDER=1

# --- Binance MCP market-data provider (INACTIVE by default) ---------------
# The MCP provider is a real Streamable HTTP client that talks to the official
# Binance Agent MCP endpoint. It is NOT in the default chain and only activates
# when ALL THREE conditions hold:
#
# 1. BINANCE_ENABLE_MCP_PROVIDER=1
# 2. BINANCE_MCP_ACCESS_TOKEN is set (server-side secret, never sent to client)
# 3. BINANCE_MARKET_DATA_PROVIDER=binance-mcp (or added to a custom chain)
#
# Known external blocker: Binance's hosted Agent MCP endpoint rejects
# unsupported agents with "The AI Agent you are using is not currently
# supported." Do not bypass this restriction; only set these when a real,
# supported-agent bearer token is available.
#
# BINANCE_ENABLE_MCP_PROVIDER=1
# BINANCE_MCP_ACCESS_TOKEN=your_real_bearer_token_here
# BINANCE_MCP_ENDPOINT_URL=https://agent.binance.com/mcp/agentic

# --- LLM provider (optional) ---------------------------------------------
# The agent pipeline runs in deterministic mock mode if no key is set.
#   LLM_PROVIDER=mock    (default, no key required)
#   LLM_PROVIDER=openai  (requires OPENAI_API_KEY below)
#
# OPENAI_API_KEY=sk-your_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# LLM_PROVIDER=mock

# --- Public Binance API base URL (optional override) ---------------------
# BINANCE_API_BASE_URL=https://api.binance.com

# --- Binance MCP OAuth (Phase 5) -----------------------------------------
# The public HTTPS base URL of this deployment (required for OAuth).
# The Binance authorization server must be able to reach this URL to fetch
# the client metadata document and to redirect after authorization.
# Examples:
#   NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
#   NEXT_PUBLIC_BASE_URL=https://your-app.onrender.com
#
# When running locally with `next dev`, defaults to http://localhost:3000
# which will NOT work for real Binance authorization (HTTPS required).
# NEXT_PUBLIC_BASE_URL=

# --- Secret used to encrypt the OAuth token cookie (production) ----------
# Must be at least 32 characters. Not needed in local dev (dev fallback key).
# BINANCE_MCP_STORE_SECRET=change_me_to_a_random_32_plus_character_string